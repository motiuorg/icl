---
import { localizeHref, tr, type Lang } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ca") as Lang;
const t = tr(lang);

const slogan = t({
    ca: "Aturem el genocidi, aturem l'ecocidi",
    en: "Stop the genocide, stop the ecocide",
});
const about = t({
    ca: "Aquest mockup està inspirat en el grup Boicot ICL i utilitza materials del seu dossier i del seu web. La campanya és seva; el web oficial és:",
    en: "This mockup is inspired by the Boicot ICL group and uses materials from its dossier and website. The campaign is theirs; the official site is:",
});
const aboutLink = t({ ca: "boicoticl.org", en: "boicoticl.org" });
const madeByTitle = t({ ca: "Fet per Motiu", en: "Made by Motiu" });
const madeByText = t({
    ca: "Motiu és una cooperativa que construeix infraestructura per a la regeneració territorial. Aquest mockup és una proposta per discutir amb la campanya, no un espai oficial de Boicot ICL.",
    en: "Motiu is a cooperative building infrastructure for territorial regeneration. This mockup is a proposal to discuss with the campaign — not an official Boicot ICL space.",
});
const motiuSite = t({ ca: "motiu.org", en: "motiu.org" });
const motiuContact = t({ ca: "Contacte amb Motiu", en: "Contact Motiu" });
const systemLink = t({
    ca: "Proposta de sistema obert",
    en: "Open system proposal",
});
const linksTitle = t({ ca: "Enllaços", en: "Links" });
const researchLink = t({
    ca: "Investigació (web de la campanya)",
    en: "Research (campaign website)",
});
const fgcLink = t({
    ca: "Campanya FGC (web de la campanya)",
    en: "FGC campaign (campaign website)",
});
const internalLink = t({
    ca: "Capa interna (demo)",
    en: "Internal layer (demo)",
});
const meta = t({
    ca: "Mockup experimental de Motiu, inspirat en Boicot ICL — no és un espai oficial de la campanya.",
    en: "Experimental mockup by Motiu, inspired by Boicot ICL — not an official campaign space.",
});
---

<style>
    .foot {
        background: var(--navy);
        color: #fff;
        border-radius: var(--radius-lg);
        max-width: var(--content);
        margin: var(--space-5) auto var(--space-4);
        padding: var(--space-4) clamp(1rem, 4vw, 2.5rem);
        position: relative;
        overflow: hidden;
    }
    .foot::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse 60% 45% at 80% 110%,
                rgba(255, 255, 255, 0.14),
                transparent 70%
            ),
            radial-gradient(
                ellipse 40% 30% at 15% 120%,
                rgba(255, 255, 255, 0.1),
                transparent 70%
            );
        pointer-events: none;
    }
    .foot-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: var(--space-3);
        position: relative;
        z-index: 1;
    }
    .foot h3 {
        color: #fff;
        font-size: 1.05rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .foot ul {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.9rem;
    }
    .foot li {
        margin-bottom: 0.45em;
    }
    .foot .slogan {
        margin-top: var(--space-3);
        text-align: center;
    }
    .foot .pill {
        color: var(--navy);
        background: #fff;
        font-size: 0.85rem;
    }
    .foot .meta {
        font-size: 0.78rem;
        opacity: 0.65;
        margin-top: var(--space-2);
        text-align: center;
    }
    .foot a {
        color: #fff;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
    }
</style>

<footer class="foot">
    <div class="foot-grid">
        <div>
            <h3>{t({ ca: "Inspirat en Boicot ICL", en: "Inspired by Boicot ICL" })}</h3>
            <p style="font-size: 0.92rem; margin: 0">
                {about} <a href="https://boicoticl.org">{aboutLink}</a>.
            </p>
        </div>
        <div>
            <h3>{madeByTitle}</h3>
            <p style="font-size: 0.92rem; margin: 0 0 0.7em">{madeByText}</p>
            <ul>
                <li>
                    🌍 <a href="https://motiu.org">{motiuSite}</a>
                </li>
                <li>
                    ✉️ <a href="https://motiu.org/contact">{motiuContact}</a>
                </li>
                <li>
                    💡 <a href={localizeHref(lang, "/sistema/")}>{systemLink}</a>
                </li>
            </ul>
        </div>
        <div>
            <h3>{linksTitle}</h3>
            <ul>
                <li>
                    <a href="https://boicoticl.org/investigacio/">
                        {researchLink}
                    </a>
                </li>
                <li>
                    <a href="https://boicoticl.org/fgc/">{fgcLink}</a>
                </li>
                <li>
                    <a href={localizeHref(lang, "/intern/")}>{internalLink}</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="slogan">
        <span class="pill">{slogan}</span>
    </div>
    <p class="meta">{meta}</p>
</footer>
