---
import Base from "../../layouts/Base.astro";
import { timeline, timelineNote } from "../../data/timeline";
import { tr, type Lang, type Bilingual } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "ca") as Lang;
const t = tr(lang);

const heroPill: Bilingual = { ca: "Fets documentats", en: "Documented facts" };
const pageTitle: Bilingual = { ca: "Cronologia", en: "Timeline" };
const h1: Bilingual = { ca: "La lluita, en dates", en: "The fight, in dates" };
const lede: Bilingual = {
    ca: 'Només fets documentats (dossier de novembre de 2025 i boicoticl.org). Colors: <span class="tag tag--red">lluita</span> <span class="tag">danys</span> <span class="tag tag--navy">corporatiu</span> <span class="tag tag--green">institucional</span>.',
    en: 'Only documented facts (November 2025 dossier and boicoticl.org). Colours: <span class="tag tag--red">struggle</span> <span class="tag">damage</span> <span class="tag tag--navy">corporate</span> <span class="tag tag--green">institutional</span>.',
};
---

<Base title={t(pageTitle)}>
    <section>
        <span class="pill pill--ghost">{t(heroPill)}</span>
        <h1>{t(h1)}</h1>
        <p class="lede" set:html={t(lede)} />
    </section>

    <section class="section">
        <div class="card">
            <div class="tl">
                {timeline.map((e) => (
                    <div class={`tl__item tl__item--${e.cat}`}>
                        <span class="tl__year">{e.year}</span>
                        <h3 style="font-size:1.1rem;margin:.1em 0 .3em">
                            {t(e.title)}
                        </h3>
                        <p style="margin:0 0 .2em">{t(e.text)}</p>
                        <span class="src" style="display:inline">
                            {e.source}
                        </span>
                    </div>
                ))}
            </div>
        </div>
        <div class="note-box note-box--warn" style="margin-top:var(--space-3)">
            {t(timelineNote)}
        </div>
    </section>
</Base>

<style>
    .lede {
        max-width: 52rem;
        font-size: 1.05rem;
    }
</style>
