const lang = (Astro.currentLocale ?? "ca") as Lang;
const t = tr(lang);

const MOTIU = '<a href="https://motiu.org">Motiu</a>';
const BOICOT = '<a href="https://boicoticl.org">boicoticl.org</a>';

const pageTitle: Bilingual = {
    ca: "corpo-fight toolkit · brainstorming",
    en: "corpo-fight toolkit · brainstorming",
};
const pageDesc: Bilingual = {
    ca: "Mockup de brainstorming de Motiu: un possible toolkit obert i reutilitzable per a territoris que planten cara a multinacionals. Pensat per recollir aportacions i feedback.",
    en: "Brainstorming mockup by Motiu: a possible open, reusable toolkit for territories fighting multinationals. Meant to collect input and feedback.",
};

// ---------- Hero ----------
const badge: Bilingual = {
    ca: "Brainstorming · de Motiu · no és un espai oficial de la campanya",
    en: "Brainstorming · by Motiu · not an official campaign space",
};
const h1: Bilingual = {
    ca: "Dels materials d'una lluita a un kit de campanya que qualsevol territori pot reutilitzar.",
    en: "From one struggle's existing material to a campaign kit any territory can reuse.",
};
const sub: Bilingual = {
    ca: "Una proposta de Motiu per imaginar, a partir d'aquest mockup inspirat en la campanya Boicot ICL, un sistema obert i reutilitzable per a comunitats que planten cara a multinacionals que fan mal al seu territori. Estem en fase de brainstorming: aquest web és un mockup pensat per recollir aportacions i feedback.",
    en: "A proposal by Motiu to imagine, from this mockup inspired by the Boicot ICL campaign, an open, reusable system for communities fighting multinationals that damage their land. Brainstorming phase: this website is a mockup meant to collect input and feedback.",
};
const ctaRead: Bilingual = {
    ca: "Llegeix la proposta",
    en: "Read the proposal",
};
const workingName: Bilingual = {
    ca: "Nom provisional",
    en: "Temporary name",
};

const honesty: Bilingual = {
    ca: `<strong>Llegiu això primer.</strong> La idea del toolkit és de ${MOTIU}. Aquest mockup està <strong>inspirat en el grup Boicot ICL</strong> i fet amb materials del seu dossier públic i del seu web (${BOICOT}): sense la seva feina no existiria. És una primera exploració petita, no una demo acabada ni un producte llest per presentar. No és un espai oficial de la campanya i Boicot ICL no l'ha avalat. Hem fet servir IA per redactar i muntar; no sabem si ja existeix una eina equivalent: això també forma part de la recerca oberta.`,
    en: `<strong>Read this first.</strong> The toolkit idea is ${MOTIU}'s. This mockup is <strong>inspired by the Boicot ICL group</strong> and built with materials from its public dossier and website (${BOICOT}): it would not exist without their work. It is a small early exploration, not a finished demo or a product ready to pitch. It is not an official campaign space and Boicot ICL has not endorsed it. AI was used for drafting and assembly; we do not know whether an equivalent tool already exists: that is also part of the open research.`,
};

// ---------- 1. Problema ----------
const problemTitle: Bilingual = { ca: "El problema", en: "The problem" };
const problemEyebrow: Bilingual = { ca: "Per què", en: "Why" };
