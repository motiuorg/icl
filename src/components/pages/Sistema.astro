};
const printFoot: Bilingual = {
    ca: "Fet per Motiu · proposta experimental, no oficial de Boicot ICL · motiu.org",
    en: "Made by Motiu · experimental proposal, not an official Boicot ICL space · motiu.org",
};
---

<Base title={t(pageTitle)} desc={t(pageDesc)}>
    <section class="hero">
        <span class="pill pill--ghost">{t(badge)}</span>
        <h1>{t(h1)}</h1>
        <p class="hero__lede">{t(sub)}</p>
        <p class="hero__name">
            <strong>
                {t(workingName)}: {PROJECT_NAME}
            </strong>{" "}
            · {t(PROJECT_TAGLINE)}
        </p>
        <div class="hero__cta no-print">
            <a class="btn btn--soft" href="#two-pager">
                {t(ctaRead)}
            </a>
        </div>
    </section>

    <div id="two-pager">
        <div class="sp sp-p1">
            <div
                class="note-box note-box--warn honesty"
                set:html={t(honesty)}
            />

            <section class="section" id="problema">
                <div class="section-title">
                    <h2>{t(problemTitle)}</h2>
                    <span class="eyebrow">{t(problemEyebrow)}</span>
                </div>
                <div class="card">
                    <p class="mb-0">{t(problemText)}</p>
                </div>
            </section>

            <section class="section" id="prova">
                <div class="section-title">
                    <h2>{t(proofTitle)}</h2>
                    <span class="eyebrow">{t(proofEyebrow)}</span>
                </div>
                <div class="card">
                    <p set:html={t(proofIntro)} />
                    <ul class="ticks">
                        {t(proofList).map((s) => (
                            <li>{s}</li>
                        ))}
                    </ul>
                    <div class="shots">
                        {shots.map((s) => (
                            <figure>
                                <Image
                                    src={s.img[lang]}
                                    alt={t(s.alt)}
                                    width={640}
                                    format="webp"
                                    quality={78}
                                    loading="lazy"
                                />
                                <figcaption>{t(s.cap)}</figcaption>
                            </figure>
                        ))}
                    </div>
                </div>
            </section>

            <section class="section" id="sistema">
                <div class="section-title">
                    <h2>{t(sysTitle)}</h2>
                    <span class="eyebrow">{t(sysEyebrow)}</span>
                </div>
                <div class="card">
                    <p class="sys-intro">{t(sysIntro)}</p>
                    <SystemDiagram />
                    <div class="layers">
                        {layers.map((l) => (
                            <div class="layer">
                                <span class="eyebrow">{t(l.tag)}</span>
                                <h3>{t(l.title)}</h3>
                                <p>{t(l.text)}</p>
                                <span class="tag tag--navy">{t(l.status)}</span>
                            </div>
                        ))}
                    </div>
                    <hr class="rule" />
                    <div class="ai-ba">
                        <div>
                            <h3>{t(aiTitle)}</h3>
                            <p class="mb-0" set:html={t(aiText)} />
                        </div>
                        <div class="ba-wrap">
                            <h3>{t(baTitle)}</h3>
                            <BeforeAfter />
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="sp sp-p2">
            <section class="section" id="principis">
                <div class="section-title">
                    <h2>{t(prinTitle)}</h2>
                    <span class="eyebrow">{t(prinEyebrow)}</span>
                </div>
                <div class="grid principles">
                    {principles.map((p, i) => (
                        <div class="card principle">
                            <span class="num">{i + 1}</span>
                            <h3>{t(p.title)}</h3>
                            <p class="mb-0">{t(p.text)}</p>
                        </div>
                    ))}
                </div>
            </section>

            <section class="section" id="panorama">
                <div class="section-title">
                    <h2>{t(landTitle)}</h2>
                    <span class="eyebrow">{t(landEyebrow)}</span>
                </div>
                <div class="card">
                    <p>{t(landIntro)}</p>
                    <div class="land">
                        {land.map((e) => (
                            <div class="land__item">
                                <h4>
                                    <a href={e.href}>{e.name}</a>
                                </h4>
                                <p>
                                    <strong>{t(doesLabel)}:</strong> {t(e.does)}
                                </p>
                                <p>
                                    <strong>{t(notLabel)}:</strong> {t(e.not)}
                                </p>
                            </div>
                        ))}
                    </div>
                    <p class="muted small-note">{t(landNote)}</p>
                    <p class="mb-0" set:html={t(newText)} />
                </div>
            </section>

            <section class="section" id="fase1">
                <div class="section-title">
                    <h2>{t(phaseTitle)}</h2>
                    <span class="eyebrow">{t(phaseEyebrow)}</span>
                </div>
                <div class="card phase">
                    <div>
                        <p class="budget">{t(budget)}</p>
                        <p>{t(budgetNote)}</p>
                        <p class="mb-0">
                            <strong>{t(noFunds)}</strong>
                        </p>
                    </div>
                    <ul class="ticks">
                        {t(deliverables).map((s) => (
                            <li>{s}</li>
                        ))}
                    </ul>
                </div>
            </section>

            <section class="section" id="fronts">
                <div class="section-title">
                    <h2>{t(frontsTitle)}</h2>
                    <span class="eyebrow">{t(frontsEyebrow)}</span>
                </div>
                <div class="card">
                    <ul class="fronts">
                        {fronts.map((f) => (
                            <li>
                                <strong>{t(f.place)}.</strong> {t(f.text)}
                                {f.link && (
                                    <>
                                        {" "}
                                        <a href={f.link}>({t(f.linkLabel!)})</a>
                                    </>
                                )}
                            </li>
                        ))}
                        <li class="slot">
                            <strong>{t(frontSlot)}</strong>
                        </li>
                    </ul>
                    <p class="muted small-note mb-0">{t(frontsNote)}</p>
                </div>
            </section>

            <section class="section" id="preguntes">
                <div class="section-title">
                    <h2>{t(askTitle)}</h2>
                    <span class="eyebrow">{t(askEyebrow)}</span>
                </div>
                <div class="card ask">
                    <ol>
                        {t(questions).map((q) => (
                            <li>{q}</li>
                        ))}
                    </ol>
                    <p class="mb-0">
                        <span set:html={t(contact)} /> {t(nameNote)}
                    </p>
                </div>
            </section>
        </div>
    </div>

    <p class="print-foot">{t(printFoot)}</p>
</Base>

<style>
    .hero {
        padding: var(--space-3) 0 var(--space-2);
        color: #fff;
    }
    .hero h1 {
        color: #fff;
        margin: 0.5em 0 0.4em;
        font-size: clamp(2rem, 5vw, 3.4rem);
        max-width: 22ch;
    }
    .hero__lede {
        max-width: 46rem;
        font-size: 1.12rem;
    }
    .hero__name {
        max-width: 46rem;
        font-size: 0.95rem;
    }
    .hero__cta {
        display: flex;
        gap: 0.9rem;
        flex-wrap: wrap;
        margin-top: var(--space-2);
    }
    .honesty {
        margin-top: var(--space-2);
        background: var(--paper);
    }
    .honesty :global(a) {
        font-weight: 700;
    }
    .ticks {
        margin: 0 0 var(--space-2);
        padding: 0;
        list-style: none;
    }
    .ticks li {
        padding-left: 1.5em;
        position: relative;
        margin-bottom: 0.35em;
    }
    .ticks li::before {
        content: "✓";
        position: absolute;
        left: 0;
        font-weight: 800;
        color: #c40000;
    }
    .shots {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: var(--space-2);
    }
    .shots figure {
        margin: 0;
    }
    .shots :global(img) {
        width: 100%;
        height: auto;
        border-radius: var(--radius-sm);
        border: 2px solid var(--ink);
        display: block;
    }
    .shots figcaption {
        font-size: 0.85rem;
        margin-top: 0.4rem;
    }
    .layers {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-2);
        margin-top: var(--space-3);
    }
    .layer {
        background: var(--paper-2);
        border-radius: var(--radius-md);
        padding: 1.2rem 1.3rem;
    }
    .layer h3 {
        margin: 0.2em 0 0.4em;
    }
    .layer .tag {
        display: inline-block;
    }
    .layer p {
        font-size: 0.95rem;
    }
    .ai-ba {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3);
        align-items: start;
    }
    @media (max-width: 800px) {
        .ai-ba {
            grid-template-columns: 1fr;
        }
    }
    .principles {
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: var(--space-2);
    }
    .principle {
        padding: 1.3rem;
    }
    .principle h3 {
        font-size: 1.05rem;
    }
    .principle p {
        font-size: 0.92rem;
    }
    .num {
        display: inline-flex;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: var(--navy);
        color: #fff;
        font-family: var(--font-display);
        font-weight: 800;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.6rem;
    }
    .land {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: var(--space-2) var(--space-3);
    }
    .land__item h4 {
        margin: 0 0 0.2em;
        font-size: 1.05rem;
    }
    .land__item p {
        font-size: 0.9rem;
        margin: 0 0 0.3em;
    }
    .small-note {
        font-size: 0.85rem;
    }
    .phase {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3);
    }
    @media (max-width: 800px) {
        .phase {
            grid-template-columns: 1fr;
        }
    }
    .budget {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.8rem;
        line-height: 1.1;
        margin-bottom: 0.4em;
    }
    .fronts {
        margin: 0 0 var(--space-2);
        padding-left: 1.2em;
    }
    .fronts li {
        margin-bottom: 0.4em;
    }
    .fronts .slot {
        list-style: none;
        margin-left: -1.2em;
        border: 2px dashed var(--ink);
        border-radius: var(--radius-sm);
        padding: 0.6em 1em;
    }
    .ask ol {
        margin: 0 0 var(--space-2);
        padding-left: 1.3em;
        font-weight: 600;
    }
    .ask li {
        margin-bottom: 0.3em;
    }
    .print-foot {
        display: none;
    }

    /* Dues pàgines A4 per llengua: fons blanc, accents vermell i blau marí. */
    @media print {
        @page {
            size: A4;
            margin: 7mm 10mm;
        }
        :global(html),
        :global(body) {
            background: #fff !important;
            font-size: 8.6pt;
            line-height: 1.3;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        :global(.nav-wrap),
        :global(footer.foot),
        .no-print {
            display: none !important;
        }
        :global(.page) {
            max-width: none;
            padding: 0;
        }
        a {
            text-decoration: none;
        }
        .hero {
            color: var(--ink);
            padding: 0;
            border-bottom: 3px solid var(--red-bright);
            margin-bottom: 2mm;
        }
        .hero .pill--ghost {
            background: var(--red-bright);
            color: #fff;
            font-size: 6.5pt;
        }
        .hero h1 {
            color: var(--navy);
            font-size: 18pt;
            margin: 0.25em 0;
            max-width: none;
        }
        .hero__lede {
            font-size: 8pt;
            margin: 0 0 0.3em;
        }
        .hero__name {
            font-size: 8pt;
            margin: 0 0 0.4em;
        }
        .sp-p2 {
            break-before: page;
        }
        .section {
            margin-top: 2mm;
            break-inside: avoid;
        }
        .section h2 {
            font-size: 12pt;
            color: var(--navy);
            border-bottom: 1.5px solid var(--red-bright);
            margin: 0 0 0.25em;
        }
        .section-title {
            gap: 0.5rem;
        }
        .eyebrow {
            font-size: 6pt;
        }
        .card,
        .honesty,
        .layer,
        .principle {
            background: #fff !important;
            box-shadow: none;
            border: 0.75pt solid #999;
            border-radius: 8px;
            padding: 2.2mm 3mm !important;
        }
        .layer {
            background: #f6f6f6 !important;
            border: 0.75pt solid #bbb;
        }
        .honesty {
            border: 0.75pt solid var(--navy);
            border-left: 3pt solid var(--red-bright);
            font-size: 7.2pt;
            line-height: 1.25;
            border-radius: 4px;
            margin: 0;
        }
        p {
            margin: 0 0 0.35em;
        }
        h3 {
            font-size: 9.2pt;
            margin: 0 0 0.15em;
        }
        .shots {
            grid-template-columns: repeat(4, 1fr);
            gap: 2mm;
        }
        .shots figcaption {
            font-size: 6.4pt;
            line-height: 1.2;
        }
        .shots :global(img) {
            border-width: 1pt;
            aspect-ratio: 2.5 / 1;
            object-fit: cover;
            object-position: top;
        }
        .ticks {
            margin: 0 0 0.4em;
            columns: 2;
            column-gap: 6mm;
        }
        .ticks li {
            break-inside: avoid;
            margin-bottom: 0.15em;
        }
        .layers {
            grid-template-columns: repeat(4, 1fr);
            gap: 2mm;
            margin-top: 1mm;
        }
        .sys-intro {
            display: none;
        }
        :global(.sysdiag) {
            max-width: 70%;
            margin: 0 auto;
        }
        .layer {
            padding: 1.6mm 2.2mm !important;
        }
        .layer p {
            line-height: 1.25;
        }
        .layer p {
            font-size: 7.6pt;
            margin-bottom: 0.25em;
        }
        .layer .tag {
            font-size: 6pt;
        }
        .rule {
            margin: 2mm 0;
        }
        .ai-ba {
            grid-template-columns: 1.25fr 1fr;
            gap: 4mm;
        }
        .ai-ba p {
            font-size: 7.6pt;
        }
        .ba-wrap h3 {
            display: none;
        }
        :global(.ba) {
            gap: 1mm !important;
        }
        :global(.ba__side) {
            padding: 1.5mm !important;
        }
        :global(.ba__side svg) {
            width: 62px !important;
        }
        :global(.ba__side h4) {
            font-size: 7pt !important;
        }
        :global(.ba__side ul) {
            font-size: 6.4pt !important;
        }
        :global(.ba__arrow) {
            font-size: 12pt !important;
            transform: none !important;
        }
        .principles {
            grid-template-columns: repeat(5, 1fr) !important;
            gap: 2mm !important;
        }
        .principle h3 {
            font-size: 8pt;
        }
        .principle p {
            font-size: 7pt !important;
        }
        .num {
            width: 5mm;
            height: 5mm;
            font-size: 7pt;
            margin-bottom: 1mm;
        }
        .land {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5mm 5mm;
        }
        .land__item h4 {
            font-size: 8pt;
        }
        .land__item p {
            font-size: 7pt;
            margin-bottom: 0.1em;
        }
        .small-note {
            font-size: 6.6pt !important;
        }
        .phase {
            grid-template-columns: 1fr 1.2fr;
            gap: 4mm;
        }
        .budget {
            font-size: 14pt;
            color: var(--red-bright);
        }
        .fronts .slot {
            padding: 0.3em 0.8em;
        }
        .ask ol {
            margin-bottom: 0.4em;
        }
        .print-foot {
            display: block !important;
            margin: 3mm 0 0;
            padding-top: 1.5mm;
            border-top: 1pt solid var(--navy);
            font-size: 6.8pt;
            color: var(--navy);
        }
    }
</style>
