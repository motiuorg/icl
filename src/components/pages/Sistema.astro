import { PROJECT_NAME, PROJECT_TAGLINE } from "../../config/project";
import { tr, type Lang, type Bilingual } from "../../i18n/utils";
import homeCa from "../../assets/proof/home-ca.png";
import homeEn from "../../assets/proof/home-en.png";
