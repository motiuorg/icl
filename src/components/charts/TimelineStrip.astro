---
// Eix temporal lineal (SVG estàtic): 1988 → 2027, amb marcadors.
import { tr, type Lang } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "ca") as Lang;
const t = tr(lang);

const title = t({ ca: "Línia del temps clau", en: "Key timeline" });

const EVENTS: {
    year: number;
    shown?: string;
    label: { ca: string; en: string };
    sub: { ca: string; en: string };
}[] = [
    {
        year: 1988,
        shown: "1988–89",
        label: { ca: "Col·lector", en: "Collector" },
        sub: { ca: "120 km", en: "120 km" },
    },
    {
        year: 1998,
        shown: "1998–99",
        label: { ca: "ICL a Catalunya", en: "ICL in Catalonia" },
        sub: { ca: "privatització", en: "privatisation" },
    },
    {
        year: 2005,
        label: { ca: "Crida BDS", en: "BDS call" },
        sub: { ca: "170+ organitzacions", en: "170+ organisations" },
    },
    {
        year: 2009,
        shown: "2008–09",
        label: { ca: "Barri de l'Estació", en: "Estació neighbourhood" },
        sub: { ca: "evacuació", en: "evacuated" },
    },
    {
        year: 2014,
        label: { ca: "Condemna penal", en: "Criminal conviction" },
        sub: { ca: "3 exdirectius", en: "3 ex-executives" },
    },
    {
        year: 2019,
        label: { ca: "Contracte FGC", en: "FGC contract" },
        sub: { ca: "30 anys · 43 M€", en: "30 yrs · €43M" },
    },
    {
        year: 2020,
        label: { ca: "Tanca Sallent", en: "Sallent closes" },
        sub: { ca: "terminal Port", en: "port terminal" },
    },
    {
        year: 2023,
        label: { ca: "Genocidi a Gaza", en: "Genocide in Gaza" },
        sub: { ca: "trens: 745", en: "trains: 745" },
    },
    {
        year: 2025,
        label: { ca: "Trens: 1110", en: "Trains: 1,110" },
        sub: { ca: "+45%", en: "+45%" },
    },
    {
        year: 2026,
        label: { ca: "Germinació 2026", en: "Germinació 2026" },
        sub: { ca: "campanya", en: "campaign" },
    },
    {
        year: 2027,
        label: { ca: "Nou col·lector", en: "New collector" },
        sub: { ca: "previst", en: "planned" },
    },
];

const W = 900;
const x0 = 60;
const x1 = 860;
const y = 60;
const GAP = 70;
const jitter = [0, 14, -14, 0, 14, -14, 0, 14, -14, 0, 14];
---

<svg viewBox={`0 0 ${W} 150`} style="width:100%;height:auto" role="img">
    <text
        x={x0}
        y={30}
        font-size="11"
        font-weight="700"
        text-transform="uppercase"
        letter-spacing="1.5"
    >
        {title}
    </text>
    <line x1={x0} y1={y} x2={x1} y2={y} stroke="var(--ink)" stroke-width="3" />
    {EVENTS.map((e, i) => {
        const x = i * GAP + x0;
        const dy = jitter[i];
        return (
            <>
                <line
                    x1={x}
                    y1={y}
                    x2={x}
                    y2={y + 24 + dy}
                    stroke="var(--ink)"
                    stroke-width="1.6"
                />
                <circle
                    cx={x}
                    cy={y}
                    r="5"
                    fill={e.year >= 2025 ? "var(--red-bright)" : "var(--sky)"}
                    stroke="var(--ink)"
                    stroke-width="1.6"
                />
                <text
                    x={x}
                    y={y + 40 + dy}
                    font-size="11.5"
                    font-weight="800"
                    text-anchor="middle"
                    font-family="inherit"
                >
                    {e.shown ?? e.year}
                </text>
                <text
                    x={x}
                    y={y + 55 + dy}
                    font-size="9.5"
                    text-anchor="middle"
                    fill="rgba(0,0,0,.72)"
                >
                    {t(e.label)}
                </text>
                <text
                    x={x}
                    y={y + 67 + dy}
                    font-size="8.5"
                    text-anchor="middle"
                    fill="rgba(0,0,0,.5)"
                >
                    {t(e.sub)}
                </text>
            </>
        );
    })}
</svg>
