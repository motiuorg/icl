---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    desc?: string;
}

const {
    title = "Boicot ICL — Estat de la lluita",
    desc = "Prototip experimental de Motiu (motiu.org): sistema de coneixement i coordinació per a la campanya Boicot ICL. Complement de boicoticl.org.",
} = Astro.props;
const pageTitle = title.includes("Boicot ICL")
    ? title
    : `${title} · Boicot ICL`;
---

<!doctype html>
<html lang={Astro.currentLocale ?? "ca"}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={desc} />
        <meta name="robots" content="noindex" />
        <link
            rel="icon"
            href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✊</text></svg>"
        />
    </head>
    <body>
        <Nav />
        <main class="page">
            <slot />
        </main>
        <Footer />
        <script>
            // Porta de demo (capa interna): el bloqueig és de demostració.
            // En producció caldrà autenticació real (decisió de la campanya).
            const DEMO_PASS = "icl-2026";
            const KEY = "icl-demo-ok";
            const gate = document.querySelector("[data-gate]");
            if (gate) {
                if (sessionStorage.getItem(KEY) === "1") {
                    gate.hidden = true;
                    document
                        .querySelectorAll("[data-gated]")
                        .forEach((el) => (el.hidden = false));
                } else {
                    const form = gate.querySelector("form");
                    const err = gate.querySelector("[data-gate-error]");
                    gate.querySelector("[data-gate-locked]").hidden = false;
                    form?.addEventListener("submit", (e) => {
                        e.preventDefault();
                        const input = form.querySelector("input");
                        if (input?.value === DEMO_PASS) {
                            sessionStorage.setItem(KEY, "1");
                            gate.hidden = true;
                            document
                                .querySelectorAll("[data-gated]")
                                .forEach((el) => (el.hidden = false));
                        } else if (err) {
                            err.textContent =
                                err.dataset.err ||
                                "Contrasenya incorrecta — prova amb la de demo.";
                        }
                    });
                }
            }
        </script>
    </body>
</html>
