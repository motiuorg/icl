---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { PROJECT_NAME } from "../config/project";
import { localizeHref, type Lang } from "../i18n/utils";

interface Props {
    title?: string;
    desc?: string;
}

const {
    title = `${PROJECT_NAME} — Estat de la lluita`,
    desc = "Prototip experimental de Motiu (motiu.org), inspirat en la campanya Boicot ICL i fet amb materials del seu web i dossier (boicoticl.org). No és un espai oficial de la campanya.",
} = Astro.props;
const pageTitle = title.includes(PROJECT_NAME)
    ? title
    : `${title} · ${PROJECT_NAME}`;
const lang = (Astro.currentLocale ?? "ca") as Lang;
const credit =
    lang === "en"
        ? 'Experimental prototype by <a href="https://motiu.org">Motiu</a>, inspired by the <strong>Boicot ICL</strong> campaign and built with materials from its dossier and website (<a href="https://boicoticl.org">boicoticl.org</a>). Not an official campaign space.'
        : 'Prototip experimental de <a href="https://motiu.org">Motiu</a>, inspirat en la campanya <strong>Boicot ICL</strong> i fet amb materials del seu dossier i web (<a href="https://boicoticl.org">boicoticl.org</a>). No és un espai oficial de la campanya.';

---

<!doctype html>
<html lang={Astro.currentLocale ?? "ca"}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={desc} />
        <meta name="robots" content="noindex" />
        <link
            rel="icon"
            href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✊</text></svg>"
        />
    </head>
    <body>
        <Nav />
        <p class="credit-strip" set:html={credit} />
        <main class="page">
            <slot />
        </main>
        <Footer />
        <script>
            // Porta de demo (capa interna): el bloqueig és de demostració.
            // En producció caldrà autenticació real (decisió de la campanya).
            const DEMO_PASS = "icl-2026";
            const KEY = "icl-demo-ok";
            const gate = document.querySelector("[data-gate]");
            if (gate) {
                if (sessionStorage.getItem(KEY) === "1") {
                    gate.hidden = true;
                    document
                        .querySelectorAll("[data-gated]")
                        .forEach((el) => (el.hidden = false));
                } else {
                    const form = gate.querySelector("form");
                    const err = gate.querySelector("[data-gate-error]");
                    gate.querySelector("[data-gate-locked]").hidden = false;
                    form?.addEventListener("submit", (e) => {
                        e.preventDefault();
                        const input = form.querySelector("input");
                        if (input?.value === DEMO_PASS) {
                            sessionStorage.setItem(KEY, "1");
                            gate.hidden = true;
                            document
                                .querySelectorAll("[data-gated]")
                                .forEach((el) => (el.hidden = false));
                        } else if (err) {
                            err.textContent =
                                err.dataset.err ||
                                "Contrasenya incorrecta — prova amb la de demo.";
                        }
                    });
                }
            }
        </script>
        <style is:global>
            .credit-strip {
                max-width: var(--content);
                margin: -10px auto 18px;
                padding: 0 clamp(1rem, 4vw, 2.5rem);
                color: #fff;
                font-size: 0.82rem;
                line-height: 1.4;
            }
            .credit-strip a {
                color: #fff;
                font-weight: 700;
            }
            @media print {
                .credit-strip {
                    display: none;
                }
            }
        </style>
    </body>
</html>
